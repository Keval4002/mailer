MAIL_PROVIDER=gmail_api
MAIL_FROM=your-email@gmail.com
PUBLIC_BASE_URL=https://your-worker.your-subdomain.workers.dev
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REDIRECT_URI=https://your-worker.your-subdomain.workers.dev/auth/gmail/callback
GMAIL_POLL_SECONDS=60
GMAIL_WATCH_ENABLED=false
API_BEARER_TOKEN=replace-me
DATABASE_PATH=./data/mail_scheduler.db
FILES_DIR=./data/files
SCHEDULER_POLL_SECONDS=60
SCHEDULER_ENABLED=true
